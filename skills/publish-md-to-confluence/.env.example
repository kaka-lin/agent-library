# Copy this file to `.env` in the same folder, then fill in real values.
# NEVER commit `.env` — CONFLUENCE_PASSWORD is a secret API token.
# Confluence Cloud only.

# Cloud: host is the REST API base — MUST end with /wiki/rest/api
CONFLUENCE_HOST=https://your-site.atlassian.net/wiki/rest/api
CONFLUENCE_USERNAME=you@company.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_PASSWORD=your-api-token
CONFLUENCE_SPACE=ENG
